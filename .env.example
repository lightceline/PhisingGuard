# ==============================================================================
# PhishingGuard API — Environment Variables Template
# ==============================================================================
# Copy this file to `.env` for local development / Docker Compose:
#   cp .env.example .env
# NEVER commit your real `.env` file containing secret API keys to Git.
# ==============================================================================

# ── Server & API Hardening ──
PORT=7860
# Comma-separated origins for production, or '*' for local unpacked Chrome Extension
CORS_ALLOW_ORIGINS=*
# Sliding-window rate limit per IP (requests / 60s). Set 0 to disable during benchmarks
RATE_LIMIT_MAX_REQUESTS=120

# ── Optional RAG LLM Synthesis (POST /chat) ──
# If neither OPENAI_API_KEY nor GEMINI_API_KEY is set, PhishingGuard automatically
# falls back to 0%-hallucination Extractive RAG over the 40 local KB documents.

# Provider 1 (Prioritized when set): OpenAI-compatible / SiliconFlow / Groq / OpenRouter
OPENAI_API_KEY= 
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V3

# Provider 2 (Fallback): Google Gemini Flash (AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
