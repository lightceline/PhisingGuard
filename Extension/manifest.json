{
  "manifest_version": 3,
  "name": "PhishingGuard",
  "version": "0.1.0",
  "description": "Cảnh báo URL lừa đảo theo thời gian thực bằng mô hình học máy có giải thích (SHAP).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage", "scripting"],
  "host_permissions": ["https://phishingguard-ai43.onrender.com/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "PhishingGuard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css", "popup.js", "icons/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
